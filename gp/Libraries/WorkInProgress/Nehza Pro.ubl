module 'Nehza Pro' Output
author MicroBlocks
version 1 1 
choices nehzaPro_turnStyle 'nehzaPro;by shortest path' clockwise 'counter-clockwise' 
choices nehzaPro_dir clockwise 'counter-clockwise' 
choices nehzaPro_forwardBack forward backward 
choices nehzaPro_motor M1 M2 M3 M4 
description 'Support for Elecfreaks Nehza Pro.

Use the "np set wheels" block to achieve precise distances and turns with a two-wheeled vehicle.
Motors can be used as angle servos using the "np set angle" block.

https://shop.elecfreaks.com/products/nezha-breakout-board-v2
'
variables nehzaPro_busy nehzaPro_leftWheel nehzaPro_rightWheel nehzaPro_circumference nehzaPro_axle 

  spec ' ' 'nehzaPro_setWheels' 'np set wheels left _ right _ #BR# circumference _ mm axle _ mm' 'menu.nehzaPro_motor menu.nehzaPro_motor num num' 'M1' 'M2' 115 105
  spec ' ' 'nehzaPro_move' 'np move _ for _ mm speed _ %' 'menu.nehzaPro_forwardBack num num' 'forward' 100 30
  spec ' ' 'nehzaPro_turn' 'np turn _ by _ degrees speed _ %' 'menu.nehzaPro_dir num num' 'clockwise' 90 30
  space
  spec ' ' 'nehzaPro_runMotor' 'np run motor _ _ speed _ %' 'menu.nehzaPro_motor menu.nehzaPro_dir num' 'M1' 'clockwise' 30
  spec ' ' 'nehzaPro_stopMotor' 'np stop motor _' 'menu.nehzaPro_motor' 'M1'
  spec ' ' 'nehzaPro_stopAll' 'np stop all motors'
  space
  spec ' ' 'nehzaPro_rotateBy' 'np rotate _ _ by _ degrees speed _ %' 'menu.nehzaPro_motor menu.nehzaPro_dir num num' 'M1' 'clockwise' 90 30
  spec ' ' 'nehzaPro_rotateTo' 'np rotate _ _ to _ degrees speed _ %' 'menu.nehzaPro_motor menu.nehzaPro_dir num num' 'M1' 'clockwise' 90 30
  spec ' ' 'nehzaPro_setAngle' 'np set _ angle _ to _ degrees' 'menu.nehzaPro_motor menu.nehzaPro_turnStyle num' 'M1' 'nehzaPro;by shortest path' 0
  space
  spec 'r' 'nehzaPro_readSpeed' 'np speed _' 'menu.nehzaPro_motor' 'M1'
  spec 'r' 'nehzaPro_angle' 'np angle _' 'menu.nehzaPro_motor' 'M1'
  advanced
  spec 'r' 'nehzaPro_readTotalAngle' 'np total angle _' 'menu.nehzaPro_motor' 'M1'
  spec ' ' 'nehzaPro_resetTotalAngle' 'np reset total angle _' 'menu.nehzaPro_motor' 'M1'
  space
  spec 'r' 'nehzaPro_version' 'np version'
  space
  spec ' ' '_nehzaPro_initWheels' '_nehzaPro_initWheels'
  spec 'r' '_nezhaPro_motor' '_nezhaPro_motor _' 'menu.nehzaPro_motor' 'M1'
  spec ' ' '_nezhaPro_sendCmd' '_nezhaPro_sendCmd _ motor _ dir _ args _ _ _' 'num num num num num num'
  spec 'r' '_nezhaPro_readCmd' '_nezhaPro_readCmd _ bytes _ args _ _ _ _' 'num num num num num num'

to '_nehzaPro_initWheels' {
  if (0 != nehzaPro_leftWheel) {return}
  comment 'Use default values'
  nehzaPro_leftWheel = 'M1'
  nehzaPro_rightWheel = 'M2'
  nehzaPro_circumference = 115
  nehzaPro_axle = 105
}

to '_nezhaPro_motor' motor {
  if ('M1' == motor) {
    return 1
  } ('M2' == motor) {
    return 2
  } ('M3' == motor) {
    return 3
  } ('M4' == motor) {
    return 4
  }
  return 1
}

to '_nezhaPro_readCmd' cmd resultCount arg1 arg2 arg3 arg4 {
  waitUntil (nehzaPro_busy == 0)
  nehzaPro_busy = 1
  waitMillis 4
  '[sensors:i2cWrite]' 16 ('[data:makeList]' (hexToInt 'FF') (hexToInt 'F9') arg1 arg2 cmd arg3 arg4 0)
  waitMillis 4
  local 'buf' (newList resultCount)
  '[sensors:i2cRead]' 16 buf
  nehzaPro_busy = 0
  return buf
}

to '_nezhaPro_sendCmd' cmd motor dir arg1 arg2 arg3 {
  waitUntil (nehzaPro_busy == 0)
  nehzaPro_busy = 1
  '[sensors:i2cWrite]' 16 ('[data:makeList]' (hexToInt 'FF') (hexToInt 'F9') motor dir cmd arg1 arg2 arg3)
  nehzaPro_busy = 0
}

to nehzaPro_angle motor {
  return (((nehzaPro_readTotalAngle motor) / 10) % 360)
}

to nehzaPro_move forwardBackward mm speed {
  '_nehzaPro_initWheels'
  speed = (maximum 0 (minimum speed 100))
  local 'degrees' ((360 * mm) / nehzaPro_circumference)
  if ('forward' == forwardBackward) {
    nehzaPro_rotateBy nehzaPro_leftWheel 'clockwise' degrees speed
    nehzaPro_rotateBy nehzaPro_rightWheel 'counter-clockwise' degrees speed
  } else {
    nehzaPro_rotateBy nehzaPro_leftWheel 'counter-clockwise' degrees speed
    nehzaPro_rotateBy nehzaPro_rightWheel 'clockwise' degrees speed
  }
  waitMillis (((111 * degrees) / speed) + 200)
}

to nehzaPro_readSpeed motor {
  local 'buf' ('_nezhaPro_readCmd' (hexToInt '47') 2 ('_nezhaPro_motor' motor) 0 0 (hexToInt 'F5') 0)
  return (((at 2 buf) << 8) | (at 1 buf))
}

to nehzaPro_readTotalAngle motor {
  local 'buf' ('_nezhaPro_readCmd' (hexToInt '46') 4 ('_nezhaPro_motor' motor) 0 0 (hexToInt 'F5') 0)
  return (((((at 4 buf) << 24) | ((at 3 buf) << 16)) | ((at 2 buf) << 8)) | (at 1 buf))
}

to nehzaPro_resetTotalAngle motor {
  '_nezhaPro_sendCmd' (hexToInt '1D') ('_nezhaPro_motor' motor) 0 0 (hexToInt 'F5') 0
}

to nehzaPro_rotateBy motor dir degrees speed {
  dir = (ifExpression ('clockwise' == dir) 1 2)
  if (degrees < 0) {
    comment 'rotate the other direction'
    dir = (ifExpression (1 == dir) 2 1)
    degrees = (absoluteValue degrees)
  }
  comment 'Set the motor speed. Internal speed range is 0-900.'
  speed = (9 * (maximum 0 (minimum speed 100)))
  '_nezhaPro_sendCmd' (hexToInt '77') 0 0 ((speed >> 8) & 255) 0 (speed & 255)
  '_nezhaPro_sendCmd' (hexToInt '70') ('_nezhaPro_motor' motor) dir ((degrees >> 8) & 255) 2 (degrees & 255)
}

to nehzaPro_rotateTo motor dir degrees speed {
  degrees = ((degrees - (nehzaPro_angle motor)) % 360)
  nehzaPro_rotateBy motor dir degrees speed
}

to nehzaPro_runMotor motor dir speed {
  dir = (ifExpression ('clockwise' == dir) 1 2)
  speed = (maximum 0 (minimum speed 100))
  '_nezhaPro_sendCmd' (hexToInt '60') ('_nezhaPro_motor' motor) dir speed (hexToInt 'F5') 0
}

to nehzaPro_setAngle motor turnStyle angle {
  local 'turnMode' 1
  if ('clockwise' == turnStyle) {
    turnMode = 2
  } ('counter-clockwise' == turnStyle) {
    turnMode = 3
  }
  angle = (angle % 360)
  '_nezhaPro_sendCmd' (hexToInt '5D') ('_nezhaPro_motor' motor) 0 ((angle >> 8) & 255) turnMode (angle & 255)
  waitMillis 500
}

to nehzaPro_setWheels left right circumference axle {
  nehzaPro_leftWheel = left
  nehzaPro_rightWheel = right
  nehzaPro_circumference = circumference
  nehzaPro_axle = axle
}

to nehzaPro_stopAll {
  nehzaPro_stopMotor 'M1'
  nehzaPro_stopMotor 'M2'
  nehzaPro_stopMotor 'M3'
  nehzaPro_stopMotor 'M4'
}

to nehzaPro_stopMotor motor {
  '_nezhaPro_sendCmd' (hexToInt '5F') ('_nezhaPro_motor' motor) 0 0 (hexToInt 'F5') 0
}

to nehzaPro_turn dir turnDegrees speed {
  '_nehzaPro_initWheels'
  speed = (maximum 0 (minimum speed 100))
  comment 'Each wheel must move turnDegrees/360 * circumference of axle circle (pi * axel length)'
  local 'mm' ((turnDegrees * (314 * nehzaPro_axle)) / 36000)
  local 'degrees' ((360 * mm) / nehzaPro_circumference)
  if ('clockwise' == dir) {
    nehzaPro_rotateBy nehzaPro_leftWheel 'counter-clockwise' degrees speed
    nehzaPro_rotateBy nehzaPro_rightWheel 'counter-clockwise' degrees speed
  } else {
    nehzaPro_rotateBy nehzaPro_leftWheel 'clockwise' degrees speed
    nehzaPro_rotateBy nehzaPro_rightWheel 'clockwise' degrees speed
  }
  waitMillis (((111 * degrees) / speed) + 200)
}

to nehzaPro_version {
  local 'version' ('_nezhaPro_readCmd' (hexToInt '88') 3 0 0 0 0 0)
  return ('[data:joinStrings]' version '.')
}

