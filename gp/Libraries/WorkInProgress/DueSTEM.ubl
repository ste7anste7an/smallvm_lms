module DueSTEM
author MicroBlocks
version 1 0 
choices dueSTEM_buttonName left right up down 
description '
Support for DueSTEM board.
'

  spec ' ' 'dueSTEM_setLED' 'dueSTEM red _ green _ blue _ (0-1023)' 'auto auto auto' 100 0 200
  spec ' ' 'dueSTEM_beep' 'dueSTEM beep _ Hz _ msecs' 'num num' 440 100
  space
  spec 'r' 'dueSTEM_button' 'dueSTEM _ button?' 'menu.dueSTEM_buttonName' 'left'

to dueSTEM_beep freq msecs {
  '[io:playTone]' -1 freq
  waitMillis msecs
  '[io:playTone]' -1 0
}

to dueSTEM_button which {
  if ('left' == which) {
    return (digitalReadOp 20 'down')
  } ('right' == which) {
    return (digitalReadOp 1 'down')
  } ('up' == which) {
    return (digitalReadOp 18 'down')
  } ('down' == which) {
    return (digitalReadOp 10 'down')
  }
  return (booleanConstant false)
}

to dueSTEM_setLED r g b {
  analogWriteOp 11 r
  analogWriteOp 4 g
  analogWriteOp 2 b
}

