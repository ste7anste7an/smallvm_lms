forever {
  SoundLevel = (makerport_loudness 'mp3 player')
  if (SoundLevel > SoundLevelMax) {
    SoundLevelMax = SoundLevel
  }
  LightLevel = ('[misc:rescale]' ((SoundLevel * 100) / SoundLevelMax) 0 100 0 1023)
  if MyFolderPresent {
    for i ('[data:range]' 1 12) {
      analogWriteOp i LightLevel
      comment 'Only LEDs 3, 4, 5, 7, 8, 9, 10, 11 & 12 have variable brightness
LEDS 1, 2, 6 do not have variable brightness, but will quickly
turn on/off in response to the sound volume level.'
    }
    setNeoPixelColor (random 1 NumberOfNeopixels) (color_withBrightness (randomColor) 50)
    analogWriteOp FairyLightsPin LightLevel
  }
  if (and (and (TPin != 1) (TPin != 5)) ((makerport_loudness 'mp3 player') > 5)) {
    setServoAngle Servo1 ('[misc:rescale]' ((SoundLevel * 100) / SoundLevelMax) 0 100 0 90)
  }
}
}

