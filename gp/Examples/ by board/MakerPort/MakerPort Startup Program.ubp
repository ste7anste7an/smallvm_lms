module main
author 'Roger Wagner'
version 1 0 
description ''
variables CharacterList CharacterNames TPin KeyboardOn folder IRCodeList IRNameList KeyPosition ToneFreqList NumberOfNeopixels CharPosn Mp3Volume ToneVolume MyFolderPresent TimeStart MyFolder ReadyForTasks ReleasedTPin PrevVolume IRCodeReceived FairyLightsPin SoundLevel SoundLevelMax LightLevel MicroSDPresent Mp3VolumeLevelPin Analog Servo1 Servo2 Extra1 Extra2 SerialTx SerialRx Mp3Tx Mp3Rx IRReceiver Mp3Busy WelcometoMakerPortTrack WelcomeToMakerPortFolder QATest RedMax NeopixelPin DistancePinTrigger DistancePinEcho Folder75Present LanternNeoPixPin QANeoPixPin LightShowNeoPixPin DistanceThreshold Distance ThingIsRunning TimeEnd Folder99Present BaseVolume Volume TimeThreshold FilesSwitch DevelopmentBuild BasicMode Folder76Present HappyAngle SadAngle FaceTurned LCDWaitTime Comment LightThreshold PlayingPong ServeLeft LeftPaddleVisible RightPaddleVisible Delay SpeedUpTime ScoreLeft ScoreRight NewGameAllowed Folder50Present KeyboardChangeAllowed PinTouchedList ServoSpeed 

  spec ' ' 'Initialize lists' 'Initialize lists'
  spec ' ' 'MenuAction5' 'MenuActionAccelerometer'
  spec ' ' 'MakerPort Setup' 'System Setup'
  spec ' ' 'IsThereMyFolder' 'IsThereMyFolder01'
  spec ' ' 'PinKeyTouched' 'IRKeyTouched'
  spec ' ' 'UpArrowVolume' 'UpArrow'
  spec ' ' 'DownArrowVolume' 'DownArrow'
  spec ' ' 'IsThereMyFolder50' 'IsThereMyFolder50'
  spec ' ' 'DefinePinNumbers' 'DefinePinNumbers'
  spec ' ' 'IsThereFolder75' 'IsThereFolder75'
  spec ' ' 'myBlock' 'DoLantern'
  spec ' ' 'EnableTouchLEDsIRRemote' 'EnableTouchLEDsIRRemote'
  spec ' ' 'DefineVariables' 'DefineVariables'
  spec ' ' 'FixKeyPositionFromIR' 'FixKeyPositionFromIR'
  spec ' ' 'IncrementFolderP12' 'IncrementFolderP12'
  spec ' ' 'PinKeyTouched2' 'PinKeyTouched'
  spec ' ' 'QATestSimple' 'QATestSimple'
  spec 'r' 'IsThere Track' 'IsThere Track _ Folder _' 'auto auto' '10' '10'
  spec ' ' 'IsThereMyFolder99' 'IsThereMyFolder99'
  spec ' ' 'SystemSetup2' 'SystemSetup2'
  spec ' ' 'DoNoCard' 'DoNoCard'
  spec ' ' 'DoMrHappySad' 'DoMrHappySad'
  spec ' ' 'IsThereFolder76' 'IsThereFolder76'
  spec ' ' 'DoServeLeft' 'DoServeLeft'
  spec ' ' 'DoServeRight' 'DoServeRight'
  spec ' ' 'NewGame' 'NewGame'
  spec ' ' 'KeyboardMode' 'KeyboardMode'
  spec ' ' 'ServoMoveWthSpeed pin' 'ServoMoveWthSpeed pin _ start (-100 to 100) _ target (-100 to 100) _ speed (0-100) _' 'num num num num' 10 10 10 10

to DefinePinNumbers {
  Mp3VolumeLevelPin = 0
  Analog = 13
  Servo1 = 14
  Servo2 = 15
  Extra1 = 16
  Extra2 = 17
  SerialTx = 18
  SerialRx = 19
  Mp3Tx = 20
  Mp3Rx = 21
  IRReceiver = 22
  Mp3Busy = 23
  DistancePinTrigger = Extra1
  DistancePinEcho = Extra2
  LightShowNeoPixPin = Extra1
  LanternNeoPixPin = Servo2
  QANeoPixPin = SerialTx
  FairyLightsPin = Servo2
}

to DefineVariables {
  ServoSpeed = 25
  comment 'speed to move angle servo at (1-100)'
  LCDWaitTime = 1500
  comment 'ms to wait after displaying each status update
during startup when the LCD is attached.
There is also a "Time Threshold" for the maximum
amount of time to wait when looking for a folder.'
  TimeThreshold = 2500
  ReadyForTasks = (booleanConstant false)
  KeyboardOn = (booleanConstant false)
  comment 'KeyboardOn is for the keyboard mode, i.e., no flash card'
  TimeStart = 0
  TimeEnd = 0
  WelcomeToMakerPortFolder = 99
  WelcometoMakerPortTrack = 3
  MyFolder = 1
  MyFolderPresent = (booleanConstant false)
  comment 'MyFolder 01 is used to initiate auto-play'
  FilesSwitch = (booleanConstant false)
  NumberOfNeopixels = 64
  comment 'Folder 50 is additional sounds 1 to 12,
Folder 51 is default 1st folder for "piano" playback'
  folder = 51
  Folder50Present = (booleanConstant false)
  comment 'Folder 50 is additional sounds 1 to 12'
  Folder75Present = (booleanConstant false)
  RedMax = 255
  LightThreshold = 10
  comment 'Folder 75 is Halloween Lantern files'
  Folder76Present = (booleanConstant false)
  HappyAngle = 100
  SadAngle = -100
  FaceTurned = (booleanConstant false)
  comment 'temporarily set right after Mr. Happy-Sad changes orientation'
  comment 'Folder 76 is Mr. Happy-Sad files '
  Folder99Present = (booleanConstant false)
  comment 'Folder 99 is MakerPort welcome sounds and is used
to test for presence of the MakerPort flash drive files '
  MicroSDPresent = (booleanConstant false)
  ThingIsRunning = (booleanConstant false)
  DistanceThreshold = 30
  Mp3Volume = 30
  SoundLevel = (makerport_loudness 'mp3 player')
  SoundLevelMax = 10
  ToneVolume = 5
  PinTouchedList = ('[data:makeList]' 0 0 0 0)
  PlayingPong = (booleanConstant false)
  KeyboardChangeAllowed = (booleanConstant true)
  NewGameAllowed = (booleanConstant true)
  ServeLeft = (booleanConstant true)
  LeftPaddleVisible = (booleanConstant false)
  RightPaddleVisible = (booleanConstant false)
  Delay = 120
  SpeedUpTime = 30
  ScoreLeft = 0
  ScoreRight = 0
}

to DoMrHappySad {
  ReadyForTasks = (booleanConstant true)
  sendBroadcast 'WatchForTouch'
  forever {
    Volume = (makerport_loudness 'mp3 player')
    if (and (Volume > 5) FaceTurned) {
      comment 'happy position'
      digitalWriteOp 1 true
      setServoAngle Servo1 HappyAngle
      LCD1602_write 'Happy!' 2
      sayIt 'Happy!'
      FaceTurned = (booleanConstant false)
    }
    if (and (Volume <= 4) (not FaceTurned)) {
      comment 'sad position'
      digitalWriteOp 1 false
      setServoAngle Servo1 SadAngle
      waitMillis 250
      comment 'wait for servo to finish move'
      stopServo Servo1
      comment 'turn servo totally off to save power'
      LCD1602_write '"Sad..."' 2
      sayIt '"Sad"'
      FaceTurned = (booleanConstant true)
    }
  }
}

to DoNoCard {
  if (LCD1602_isConnected) {
    LCD1602_write '  microSD card' 1
    LCD1602_write '  not inserted' 2
    waitMillis 2000
  }
  if ('[misc:connectedToIDE]') {
    sayIt '  microSD card not inserted'
  }
  comment 'C4'
  makerport_beep 262 250
  comment 'F4'
  makerport_beep 349 250
  comment 'G4'
  makerport_beep 392 250
  ReadyForTasks = (booleanConstant true)
  EnableTouchLEDsIRRemote
}

to DoServeLeft {
  neoPanel_drawPixel 1 3 (colorSwatch 255 255 255 255)
  waitMillis (random 100 1500)
  for i ('[data:range]' 2 9) {
    waitMillis Delay
    neoPanel_drawPixel (i - 1) 3 (colorSwatch 0 0 0 255)
    neoPanel_drawPixel i 3 (color_withBrightness (colorSwatch 255 0 0 255) 50)
    if (and (or (i == 7) (i == 8)) LeftPaddleVisible) {
      makerport_beep 440 50 5
      ScoreLeft = (ScoreLeft + 1)
      neoPanel_draw_rectangle 8 (9 - ScoreLeft) 8 ScoreLeft (color_withBrightness (colorSwatch 72 218 233 255) 50)
      if (ScoreLeft == 4) {
        'play ringtone' 'Pacman:d=16,o=6,b=140:
b5,b,f#,d#,8b,8d#,c,c7,g,f,8c7,8e,b5,b,f#,d#,8b,8d#,32d#,32e,f,32f,32f#,g,32g,32g#,a,8b'
        NewGame
      }
    }
  }
  ServeLeft = (booleanConstant false)
  waitMillis 1000
}

to DoServeRight {
  neoPanel_drawPixel 8 3 (colorSwatch 255 255 255 255)
  waitMillis (random 100 1500)
  for i ('[data:range]' 7 0) {
    waitMillis Delay
    neoPanel_drawPixel (i + 1) 3 (colorSwatch 0 0 0 255)
    neoPanel_drawPixel i 3 (color_withBrightness (colorSwatch 255 0 0 255) 50)
    if (and (or (i == 2) (i == 1)) RightPaddleVisible) {
      makerport_beep 440 50
      ScoreRight = (ScoreRight + 1)
      neoPanel_draw_rectangle 1 (9 - ScoreRight) 1 ScoreRight (color_withBrightness (colorSwatch 72 218 233 255) 50)
      if (ScoreRight == 4) {
        'play ringtone' 'Pacman:d=16,o=6,b=140:
b5,b,f#,d#,8b,8d#,c,c7,g,f,8c7,8e,b5,b,f#,d#,8b,8d#,32d#,32e,f,32f,32f#,g,32g,32g#,a,8b'
        NewGame
      }
    }
  }
  ServeLeft = (booleanConstant true)
  waitMillis 1000
}

to DownArrowVolume {
  if MicroSDPresent {
    Mp3Volume += -3
    if (Mp3Volume < 0) {
      Mp3Volume = 0
    }
    mp3_setVolume Mp3Volume
    LCD1602_write_field ('[data:join]' 'V' Mp3Volume) 1 14 16
    if Folder75Present {
      ThingIsRunning = (booleanConstant false)
      myBlock
    }
  }
}

to EnableTouchLEDsIRRemote {
  if (LCD1602_isConnected) {
    LCD1602_clear
    LCD1602_write '   Touch+LEDs' 1
    LCD1602_write '  & IR Enabled' 2
  }
  waitMillis 7000
  sendBroadcast 'WatchForTouch'
  sendBroadcast 'WatchForIRCommand'
}

to FixKeyPositionFromIR {
  if (KeyPosition > 12) {
    comment 'assign remote arrows to T1-T4'
    KeyPosition = (KeyPosition - 12)
    if (KeyPosition == 5) {
      comment 'assign remote OK to T6 (click)'
      KeyPosition = 6
    }
  }
}

to IncrementFolderP12 {
  folder += 1
  if (folder == 55) {
    if Folder50Present {
      folder = 50
    } else {
      folder = 51
    }
    if KeyboardChangeAllowed {
      mp3_playTrack 55 99
      if ('[misc:connectedToIDE]') {
        sayIt 'touch button 1 for the keyboard mode, or touch 12 again
to go back to the first sound folder.'
      }
      if (LCD1602_isConnected) {
        LCD1602_clear
        LCD1602_write 'Touch button 1 ' 1
        LCD1602_write 'for the keyboard ' 2
        waitMillis 2000
        LCD1602_clear
        LCD1602_write 'or touch 12' 1
        LCD1602_write 'to go back to' 2
        waitMillis 2000
        LCD1602_clear
        LCD1602_write 'the first sound' 1
        LCD1602_write 'folder' 2
      }
      waitUntil (touch_touch_event)
      LCD1602_clear
      if ((touch_last_touched_pin) == 1) {
        if ('[misc:connectedToIDE]') {sayIt 'Keyboard Actions Enabled!'}
        if (LCD1602_isConnected) {
          LCD1602_write 'Keyboard Actions' 1
          LCD1602_write '     Enabled!' 2
          waitMillis 2000
        }
        KeyboardMode
        KeyboardChangeAllowed = (booleanConstant false)
        LCD1602_write 'Ready...' 1
        LCD1602_write '                 ' 2
        LCD1602_write_field ('[data:join]' 'Folder:' folder) 2 8 16
      } else {
        mp3_playTrack 99 folder
        LCD1602_write 'Ready...' 1
        LCD1602_write '                 ' 2
        LCD1602_write_field ('[data:join]' 'Folder:' folder) 2 8 16
      }
    }
    mp3_playTrack 99 folder
  } else {
    mp3_playTrack 99 folder
  }
  if (LCD1602_isConnected) {
    LCD1602_write_field ('[data:join]' 'Folder:' folder) 2 8 16
  }
  digitalWriteOp 12 false
}

to 'Initialize lists' {
  CharacterNames = ('[data:makeList]' 'left' 'up' 'right' 'down' 'space' 'click' 'w' 'a' 's' 'd' 'f' 'g')
  CharacterList = ('[data:makeList]' 216 218 215 217 ' ' 'click' 'w' 'a' 's' 'd' 'f' 'g')
  comment 'https://gist.github.com/MightyPork/6da26e382a7ad91b5496ee55fdc73db2'
  IRCodeList = ('[data:makeList]' 22 25 13 12 24 94 8 28 90 82 66 74 68 70 67 21 64)
  IRNameList = ('[data:makeList]' 1 2 3 4 5 6 7 8 9 0 '*' '#' 'left' 'up' 'right' 'down' 'OK')
  comment 'https://pages.mtu.edu/~suits/notefreqs.html'
  ToneFreqList = ('[data:makeList]' 262 294 330 349 392 440 494 523 587 659 698 784 880 988 1047 1175 1319)
  comment 'C4, D4, E4, F4 G4, A4'
  comment 'B4, C5, D5, E5, F5, G5'
  comment 'A5, B5, C6, D6, E6'
}

to 'IsThere Track' Track Folder {
  mp3_pause
  waitMillis 50
  mp3_setVolume 15
  waitMillis 50
  resetTimer
  mp3_playTrack Track Folder
  waitUntil (or ((makerport_loudness 'mp3 player') > 5) ((timer) > TimeThreshold))
  TimeEnd = (timer)
  mp3_pause
  waitMillis 75
  mp3_setVolume Mp3Volume
  if (and (LCD1602_isConnected) DevelopmentBuild) {
    LCD1602_write_field TimeThreshold 1 1 4
    LCD1602_write_field TimeEnd 1 13 16
    waitMillis LCDWaitTime
  }
  if (TimeEnd > TimeThreshold) {
    if ('[misc:connectedToIDE]') {
      sayIt Track Folder TimeEnd 'not found'
      waitMillis LCDWaitTime
    }
    return (booleanConstant false)
  } else {
    if ('[misc:connectedToIDE]') {
      sayIt Track Folder TimeEnd 'found'
      waitMillis LCDWaitTime
    }
    return (booleanConstant true)
  }
}

to IsThereFolder75 {
  LCD1602_write_field 'Folder 75?' 2 4 13
  if (and (LCD1602_isConnected) DevelopmentBuild) {
    LCD1602_write_field '?' 2 13 13
  }
  comment 'Folder 75 is Halloween Lantern Wind Sounds'
  if ('IsThere Track' 1 75) {
    Folder75Present = (booleanConstant true)
    mp3_playTrack 75 99
    if (LCD1602_isConnected) {
      LCD1602_write_field '*' 2 15 15
      LCD1602_clear
      LCD1602_write '   Folder 75' 1
      LCD1602_write ' for Halloween!' 2
      waitMillis LCDWaitTime
      LCD1602_write 'Distance in Extra' 1
      LCD1602_write 'NeoPixels Servo2' 2
      waitMillis LCDWaitTime
      waitMillis (17500 - (LCDWaitTime * 2))
    } else {
      waitMillis 17500
    }
  } else {
    Folder75Present = (booleanConstant false)
    if (and (LCD1602_isConnected) DevelopmentBuild) {
      LCD1602_write_field '#' 2 15 15
    }
  }
}

to IsThereFolder76 {
  LCD1602_write_field 'Folder 76?' 2 4 13
  if (and (LCD1602_isConnected) DevelopmentBuild) {
    LCD1602_write_field '?' 2 13 13
  }
  comment 'Folder 76 is Mr. Happy-Sad'
  if ('IsThere Track' 1 76) {
    Folder76Present = (booleanConstant true)
    mp3_playTrack 76 99
    if (LCD1602_isConnected) {
      LCD1602_write_field '*' 2 15 15
      LCD1602_clear
      LCD1602_write ' Folder 76 for' 1
      LCD1602_write ' Mr. Happy-Sad!' 2
      waitMillis 2000
      LCD1602_write 'Servo in Servo1' 1
      LCD1602_write '  Touch 1 & 12' 2
      waitMillis 2000
      waitMillis (12500 - (2000 * 2))
    } else {
      waitMillis 12500
    }
  } else {
    Folder76Present = (booleanConstant false)
    if (and (LCD1602_isConnected) DevelopmentBuild) {
      LCD1602_write_field '#' 2 15 15
    }
  }
}

to IsThereMyFolder {
  LCD1602_write_field 'Folder 01?' 2 4 13
  if (and (LCD1602_isConnected) DevelopmentBuild) {
    LCD1602_write_field '?' 2 16 16
  }
  if ('IsThere Track' 1 1) {
    MyFolderPresent = (booleanConstant true)
    mp3_playTrack 1 99
    if (LCD1602_isConnected) {
      LCD1602_write 'Folder 01 Found!' 1
      if DevelopmentBuild {
        LCD1602_write_field '*' 2 16 16
      }
      waitMillis LCDWaitTime
      LCD1602_write 'Servo in Servo1 ' 1
      LCD1602_write 'Fairy Lts Servo2 ' 2
      waitMillis LCDWaitTime
      LCD1602_write 'NeoPix Extra(16)' 2
      waitMillis LCDWaitTime
      waitMillis (25500 - (LCDWaitTime * 2))
    } else {
      waitMillis 25500
    }
  } else {
    MyFolderPresent = (booleanConstant false)
    if (and (LCD1602_isConnected) DevelopmentBuild) {
      LCD1602_write_field '#' 2 16 16
      waitMillis LCDWaitTime
    }
  }
}

to IsThereMyFolder50 {
  if (and (LCD1602_isConnected) DevelopmentBuild) {LCD1602_write_field '?' 2 2 2}
  LCD1602_write_field 'Folder 50?' 2 4 13
  comment 'Folder 50 holds extra user directory of mp3 files'
  if ('IsThere Track' 1 50) {
    Folder50Present = (booleanConstant true)
    folder = 50
    mp3_playTrack 50 99
    if (LCD1602_isConnected) {
      LCD1602_clear
      LCD1602_write '  More sounds' 1
      LCD1602_write ' in folder 50!' 2
      waitMillis 4500
      LCD1602_clear
      LCD1602_write '   MakerPort' 1
      waitMillis LCDWaitTime
      if DevelopmentBuild {
        if Folder99Present {
          LCD1602_write_field '**' 2 1 2
        } else {
          LCD1602_write_field '#*' 2 1 2
        }
      }
    } else {
      waitMillis 4500
    }
  } else {
    Folder50Present = (booleanConstant false)
    folder = 51
    if (and Folder99Present DevelopmentBuild) {
      LCD1602_write_field '#' 2 2 2
    }
  }
}

to IsThereMyFolder99 {
  LCD1602_write '   MakerPort' 1
  LCD1602_write_field 'Folder 99?' 2 4 13
  if (and (LCD1602_isConnected) DevelopmentBuild) {
    LCD1602_write_field '?' 2 1 1
  }
  comment 'Folder 99 holds MakerPort welcome files'
  if ('IsThere Track' 1 99) {
    Folder99Present = (booleanConstant true)
    if (and (LCD1602_isConnected) DevelopmentBuild) {
      LCD1602_write_field '*' 2 1 1
    }
  } else {
    Folder99Present = (booleanConstant false)
    if (and (LCD1602_isConnected) DevelopmentBuild) {
      LCD1602_write_field '#' 2 1 1
    }
  }
}

to KeyboardMode {
  clearNeoPixels
  NewGameAllowed = (booleanConstant false)
  PlayingPong = (booleanConstant false)
  KeyboardOn = (booleanConstant true)
  ReadyForTasks = (booleanConstant true)
  mp3_playTrack 54 99
  waitMillis 7000
  EnableTouchLEDsIRRemote
}

to 'MakerPort Setup' {
  setServoAngle Servo1 0
  waitMillis 75
  stopServo Servo1
  stopServo Servo2
  if ('[misc:connectedToIDE]') {
    sayIt 'free memory' ('[data:freeMemory]')
    waitMillis LCDWaitTime
  }
  if (LCD1602_isConnected) {
    LCD1602_write '  Welcome to' 1
    LCD1602_write ' the MakerPort!' 2
    waitMillis LCDWaitTime
    LCD1602_clear
  }
  comment '0 - not initialized
ok - ready to play tracks
no card - microSD card is not inserted
files mode - switch is in the "files" position'
  if (and (LCD1602_isConnected) DevelopmentBuild) {
    LCD1602_write ('[data:join]' 'SD:' _mp3Status) 1
    waitMillis LCDWaitTime
    LCD1602_clear
  }
  if (_mp3Status == 'files mode') {
    if (LCD1602_isConnected) {
      LCD1602_clear
      LCD1602_write 'Code Switch:' 1
      LCD1602_write 'Files Position!' 2
    }
    comment 'G4'
    makerport_beep 392 250
    comment 'F4'
    makerport_beep 349 250
    comment 'C4'
    makerport_beep 262 250
    stopAll
    stopTask
  }
  makerport_beep 3520 25 3
  IsThereMyFolder99
  comment 'Check for welcome sounds on microSD'
  if Folder99Present {
    MicroSDPresent = (booleanConstant true)
  } else {
    MicroSDPresent = (booleanConstant false)
    DoNoCard
  }
}

to MenuAction5 {
  LCD1602_write 'Accelerometer' 1
  LCD1602_write 'Tilt to Test' 2
  waitMillis 1500
  LCD1602_write ' ' 2
  for i (8 * 3) {
    LCD1602_write_field ('[data:join]' 'Acc:' ('[sensors:acceleration]')) 2 1 8
    CharPosn = ('[misc:rescale]' i 1 (8 * 4) 9 16)
    LCD1602_write_field '.' 2 CharPosn CharPosn
    makerport_beep (('[sensors:acceleration]') * 3) 50 5
    waitMillis 50
  }
}

to NewGame {
  clearNeoPixels
  if NewGameAllowed {
    Delay = (Delay - 50)
    ServeLeft = (booleanConstant true)
    ScoreLeft = 0
    ScoreRight = 0
    sendBroadcast 'ShowLeftPaddle'
    sendBroadcast 'ShowRightPaddle'
  }
}

to PinKeyTouched {
  if MicroSDPresent {
    if (TPin != 12) {
      sendBroadcast 'PlayTrack'
    } else {
      IncrementFolderP12
    }
  } else {
    makerport_beep (at TPin ToneFreqList) 100 ToneVolume
    digitalWriteOp TPin false
    if (TPin == 6) {
      '[hid:mouseRelease]'
    } else {
      '[hid:releaseKey]' (at TPin CharacterList)
    }
  }
  waitMillis 10
  sendBroadcast 'WatchForIRCommand'
  sendBroadcast 'WatchForTouch'
}

to PinKeyTouched2 {
  if MicroSDPresent {
    if (TPin != 12) {
      if (TPin == 1) {
        'ServoMoveWthSpeed pin' Servo1 0 90 ServoSpeed
        if (and PlayingPong ServeLeft) {
          sendBroadcast 'ShowLeftPaddle'
        }
        if (and (not PlayingPong) NewGameAllowed) {
          NewGame
        }
      }
      if (TPin == 5) {
        setServoSpeed Servo2 50
        if (and (not PlayingPong) NewGameAllowed) {
          NewGame
        }
      }
      if (not KeyboardOn) {
        sendBroadcast 'PlayTrack'
      } else {
        'play frequency' 880 10
      }
    } else {
      if (not KeyboardOn) {
        IncrementFolderP12
      } else {
        'play frequency' 880 10
      }
      if (and PlayingPong (not ServeLeft)) {
        sendBroadcast 'ShowRightPaddle'
      }
      if (and (not PlayingPong) NewGameAllowed) {
        NewGame
      }
    }
  } else {
    makerport_beep (at TPin ToneFreqList) 100 ToneVolume
    digitalWriteOp TPin false
  }
  sendBroadcast 'WatchForIRCommand'
}

to QATestSimple {
  LCD1602_clear
  LCD1602_write ' Simple QA Test' 1
  mp3_setVolume 30
  MenuAction5
  LCD1602_clear
  LCD1602_write 'QA Pin Test' 1
  TPin = 3
  folder = 57
  sendBroadcast 'PlayTrack'
  folder = 51
  ReadyForTasks = (booleanConstant true)
  sendBroadcast 'WatchForIRCommand'
  sendBroadcast 'WatchForTouch'
  sendBroadcast 'PortTest'
}

to 'ServoMoveWthSpeed pin' pin start target speed {
  local 'Sweep' (target - start)
  comment '1ms per degree of movement'
  local 'TotalFastestMoveTime' (Sweep * 1)
  local 'DesiredTimeForMove' ((TotalFastestMoveTime * 100) / speed)
  local 'TotalDelayPerStep' (DesiredTimeForMove / Sweep)
  for i ('[data:range]' start target 1) {
    setServoAngle pin i
    waitMillis TotalDelayPerStep
  }
}

to SystemSetup2 {
  if (and (LCD1602_isConnected) (not DevelopmentBuild)) {LCD1602_write '   MakerPort' 1}
  makerport_beep 3520 25 3
  IsThereMyFolder50
  comment 'Change 1st mp3 folder to 50 if present'
  if (and (not BasicMode) (not Folder50Present)) {
    makerport_beep 3520 25 3
    IsThereFolder75
    comment 'Folder 75 is Halloween Lantern sounds'
    if Folder75Present {
      stopAll
      sendBroadcast 'WatchForIRCommand'
      myBlock
      stopTask
      comment 'and don''t continue, but don''t stop other tasks'
    }
  }
  if (not Folder50Present) {
    makerport_beep 3520 25 3
    IsThereFolder76
    comment 'Folder 76 is Mr. Happy-Sad'
    if Folder76Present {
      stopAll
      DoMrHappySad
      stopTask
      comment 'and don''t continue, but don''t stop other tasks'
    }
  }
  comment 'continue here ONLY if nothing above was true'
  makerport_beep 3520 25 3
  waitMillis 50
  IsThereMyFolder
  ReadyForTasks = (booleanConstant true)
  sendBroadcast 'WatchForTouch'
  sendBroadcast 'WatchForIRCommand'
  mp3_setVolume Mp3Volume
  waitMillis 50
  if MyFolderPresent {
    LCD1602_write 'Auto-Play...' 1
    LCD1602_write 'Ready...' 2
    waitMillis 50
    mp3_repeatAllInFolder MyFolder
    sendBroadcast 'Servo+LightShow'
  } else {
    sendBroadcast 'Servo+LightShow'
    LCD1602_write 'Ready...' 1
    if (or (not Folder75Present) (not Folder76Present)) {
      LCD1602_write ('[data:join]' '       Folder:' folder) 2
      mp3_playTrack WelcometoMakerPortTrack WelcomeToMakerPortFolder
      sendBroadcast 'PlayPong!'
    } else {
      comment 'F4'
      makerport_beep 349 250
      comment 'G4'
      makerport_beep 392 250
    }
  }
}

to UpArrowVolume {
  if MicroSDPresent {
    Mp3Volume += 3
    if (Mp3Volume > 30) {
      Mp3Volume = 30
    }
    mp3_setVolume Mp3Volume
    LCD1602_write_field ('[data:join]' 'V' Mp3Volume) 1 14 16
    if Folder75Present {
      ThingIsRunning = (booleanConstant false)
      myBlock
    }
  }
}

to myBlock {
  neoPixelAttach NumberOfNeopixels LanternNeoPixPin
  ReadyForTasks = (booleanConstant true)
  sendBroadcast 'WatchForIRCommand'
  mp3_setVolume Mp3Volume
  waitMillis 50
  mp3_repeatAllInFolder 75
  waitMillis 50
  mp3_pause
  LCD1602_clear
  LCD1602_write '  Come Closer!' 1
  forever {
    Distance = ('distance (cm)' DistancePinTrigger DistancePinEcho)
    waitMillis 50
    LCD1602_write_field ('[data:join]' Distance 'cm' '...') 2 5 12
    LCD1602_write_field (makerport_loudness 'analog pin (13)') 2 14 16
    if (and (Distance < DistanceThreshold) ((makerport_loudness 'analog pin (13)') > LightThreshold)) {
      if (not ThingIsRunning) {
        LCD1602_write 'Happy Halloween!' 1
        ThingIsRunning = (booleanConstant true)
        mp3_resume
      } else {
        neoPixelSetAllToColor (colorFromRGB RedMax (RedMax / 2) 0)
        waitMillis (random 10 500)
        neoPixelSetAllToColor (colorSwatch 0 0 0 255)
        waitMillis (random 3 5)
      }
    } else {
      clearNeoPixels
      mp3_pause
      ThingIsRunning = (booleanConstant false)
      if ((makerport_loudness 'analog pin (13)') > LightThreshold) {
        LCD1602_write '  Come Closer!' 1
      } else {
        LCD1602_write 'Lower the lights' 1
      }
    }
  }
}

