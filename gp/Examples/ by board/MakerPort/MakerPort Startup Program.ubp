script 222 2278 {
whenBroadcastReceived 'WatchForTouch'
forever {
  if (and (touch_touch_event) ReadyForTasks) {
    digitalWriteOp TPin false
    TPin = (touch_last_touched_pin)
    LCD1602_write_field ('[data:join]' 'Touch:' TPin) 1 1 16
    if (not KeyboardOn) {
      '[data:addLast]' TPin PinTouchedList
      '[data:delete]' 1 PinTouchedList
      KeyboardChangeAllowed = (booleanConstant true)
      for i 4 {
        if ((at i PinTouchedList) != 12) {KeyboardChangeAllowed = (booleanConstant false)}
      }
    }
    if Folder76Present {
      comment 'Mr. Happy-Sad - play whenever a touchpoint
is being touched'
      mp3_playTrack 1 76
      sendBroadcast 'WatchForRelease'
    } else {
      if (or MyFolderPresent Folder75Present) {
        comment 'Cancel demo program if a touchpoint is touched
AND a demo is running (01 or 75)'
        stopAll
        MyFolderPresent = (booleanConstant false)
        Folder75Present = (booleanConstant false)
      }
      makerport_setAllLEDs false
      digitalWriteOp TPin true
      comment 'KeyboardOn = true to output characters'
      if KeyboardOn {
        LCD1602_write_field (at TPin CharacterNames) 2 1 7
        if (TPin == 6) {
          'mouse click' 'left'
        } else {
          'press key' (at TPin CharacterList)
        }
      } else {
        if (or (TPin == 1) (or (TPin == 5) (TPin == 12))) {
          comment '"You may pass" (don''t stop other tasks)'
        } else {
          comment 'Cancel pong if other than 1, 5 or 12'
          stopAll
          clearNeoPixels
          PlayingPong = (booleanConstant false)
          NewGameAllowed = (booleanConstant false)
        }
      }
      sendBroadcast 'WatchForRelease'
      sendBroadcast 'Servo+LightShow'
      PinKeyTouched2
    }
  }
  waitMillis 10
}
}

script 1322 3162 {
whenBroadcastReceived 'WatchForIRCommand'
forever {
  if (and (ir_code_received) ReadyForTasks) {
    stopAll
    makerport_setAllLEDs false
    IRCodeReceived = (ir_last_code)
    LCD1602_write ('[data:join]' 'IR code:' IRCodeReceived) 1
    KeyPosition = ('[data:find]' IRCodeReceived IRCodeList)
    if (KeyPosition <= 0) {
      LCD1602_write ('[data:join]' KeyPosition ', not found') 2
    } else {
      LCD1602_write_field ('[data:join]' KeyPosition ',' (at KeyPosition IRNameList)) 1 1 7
      FixKeyPositionFromIR
      if (KeyPosition == 2) {
        comment 'up arrow = increase volume'
        UpArrowVolume
      }
      if (KeyPosition == 4) {
        comment 'down arrow = decrease volume'
        sayIt 'down'
        DownArrowVolume
      }
      TPin = KeyPosition
      digitalWriteOp TPin true
      if KeyboardOn {
        LCD1602_write_field (at TPin CharacterNames) 2 1 16
        if (TPin == 6) {
          'mouse click' 'left'
        } else {
          'press key' (at TPin CharacterList)
        }
      }
      PinKeyTouched
    }
  }
}
}

